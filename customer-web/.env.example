# ---- BarMade backend (team API on Render) ----------------------------------------------
# When set, orders are created with POST {BARMADE_API_URL}/api/orders and menu/stock/status are
# read live from the team's data. Leave empty to run fully local.
BARMADE_API_URL=
# Optional: Firestore path of the backend's state (default barmade/state)
BARMADE_STATE_PATH=

# ---- Where customers (and local-mode orders) are stored ---------------------------------
# Firestore (team database): set FIREBASE_SERVICE_ACCOUNT and the app uses Firestore automatically.
# Paste the service-account JSON as one line, or base64 of the file. Server-side only.
FIREBASE_SERVICE_ACCOUNT=
# Optional (taken from the service account by default)
FIREBASE_PROJECT_ID=
# Optional collection names (defaults: orders, customers, counters/barmade_order_number)
FIRESTORE_ORDERS_COLLECTION=
FIRESTORE_CUSTOMERS_COLLECTION=
FIRESTORE_COUNTER_DOC=
# Force a backend: firestore | postgres (default: auto)
DATA_STORE=

# Postgres connection string (fallback: Neon / Render / Railway Postgres).
# Leave empty to run locally on an embedded Postgres stored in ./.pglite (no install needed).
DATABASE_URL=

# AI provider for suggestions + voice: claude (default) or gemini.
# With only GEMINI_API_KEY set, Gemini is used automatically.
AI_PROVIDER=
GEMINI_API_KEY=
# Optional, default gemini-3.5-flash (busy → gemini-3.5-flash-lite, override with GEMINI_FALLBACK_MODEL)
GEMINI_MODEL=

# Claude API key — server-side only, used for taste-based suggestions.
# Without it the app falls back to rule-based suggestions.
ANTHROPIC_API_KEY=

# Optional: the merchant backend can call PATCH /api/orders/:id/status with this token.
MERCHANT_API_TOKEN=

# Set to true to let the app add its columns (fulfillment, customer_id, ...) to an
# orders table that already exists in the team's database. Off by default.
DB_ALLOW_ALTER=false

# Voice ordering (mic button on the menu). Off unless "on".
NEXT_PUBLIC_VOICE_ORDERING=
