# Google Maps Platform key with the Routes API enabled.
# Leave unset to run fully offline with the haversine fallback.
GOOGLE_MAPS_API_KEY=

# BarMade kitchen backend. When set, its menu and stock appear as the
# fictional restaurant rest_barmade. Orders stay local unless forwarding is on.
# BARMADE_API_URL=https://barmade-riw5.onrender.com
# on = also send each order to BarMade's live POST /api/orders (shared data!)
# BARMADE_FORWARD_ORDERS=off
# BarMade has no restaurant profile; the defaults are fictional (downtown Miami).
# BARMADE_NAME=BarMade Kitchen
# BARMADE_LAT=25.7743
# BARMADE_LNG=-80.1925
# BARMADE_ADDRESS=120 E Flagler St, Miami, FL 33131
# BARMADE_PHONE=305-555-0104
